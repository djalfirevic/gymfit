# The database the app talks to. Neon is primary; use the connection string
# from the Neon dashboard, which already carries ?sslmode=require.
#
# Either Neon endpoint works. The pooled one (-pooler in the host) is PgBouncer
# in transaction mode, so the client disables prepared statements when it sees
# that host -- see src/lib/db/connection-options.ts. Migrations should use the
# direct endpoint, since the pooler can cut long transactions.
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Local Postgres from docker-compose, for offline work and pnpm db:restore.
LOCAL_DATABASE_URL=postgresql://gymfit:gymfit@localhost:5434/gymfit_local

APP_PASSWORD=
SESSION_SECRET=
