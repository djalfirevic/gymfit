{
  "name": "gymfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "probe:db": "tsx --tsconfig scripts/tsconfig.json scripts/probe-db.ts",
    "seed:import": "tsx --tsconfig scripts/tsconfig.json scripts/seed-import.ts",
    "sync:members": "tsx --tsconfig scripts/tsconfig.json scripts/sync-members.ts",
    "sync:payments": "tsx --tsconfig scripts/tsconfig.json scripts/sync-payments.ts",
    "sync:store": "tsx --tsconfig scripts/tsconfig.json scripts/sync-store.ts",
    "sync:expenses": "tsx --tsconfig scripts/tsconfig.json scripts/sync-expenses.ts",
    "seed:locations": "tsx --tsconfig scripts/tsconfig.json scripts/seed-locations.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.0",
    "next-intl": "^4.13.7",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
